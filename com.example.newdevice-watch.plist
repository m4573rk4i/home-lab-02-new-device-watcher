<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.cory.newdevice-watch</string>
<key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>/path/to/newdevice-watch/watch.py</string></array>
<key>StartCalendarInterval</key><dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
<key>StandardOutPath</key><string>/path/to/newdevice-watch/launchd.out</string>
<key>StandardErrorPath</key><string>/path/to/newdevice-watch/launchd.err</string>
</dict></plist>
